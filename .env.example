SITE=site-a

# In-container listen port for cloudflared on the docker network.
# Do not publish this on the host. Do not put it on the internet.
BIND_PORT=8080

# Tunnel hostnames this process may answer (avoids MCP 421).
PUBLIC_HOSTNAMES=mcp.example.com

# Cloudflare Access (origin JWT check). Team domain and AUD are per Access app.
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=

# Internal Hermes dashboard URL (private network only). Do not commit a real URL.
HERMES_DASHBOARD_URL=
HERMES_DASHBOARD_TOKEN=

# Optional OpenAI-compatible gateway. Leave empty to disable ask.
HERMES_API_URL=
HERMES_API_KEY=

# Kanban board slug; omit for Hermes current board
HERMES_KANBAN_BOARD=
