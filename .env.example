# Required. Fill before starting. Do not commit a filled copy.
SITE=site-a
PUBLIC_HOSTNAMES=mcp.example.com
HERMES_KANBAN_BOARDS=project-a,project-b
# Optional CSV. Defaults to https:// for each PUBLIC_HOSTNAMES entry.
ALLOWED_ORIGINS=https://mcp.example.com
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
# Required: per-app Access AUD. Empty here on purpose; start fails until set.
CF_ACCESS_AUD=
# Required: private-network Hermes dashboard URL. Empty until set. Do not commit a real URL.
HERMES_DASHBOARD_URL=

# Optional
BIND_PORT=8080
HERMES_DASHBOARD_TOKEN=
# Unset disables ask; dashboard tools still work.
HERMES_API_URL=
HERMES_API_KEY=
